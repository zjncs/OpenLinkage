/* pages/login/login.wxss */
.login-container {
  height: 100vh;
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  background-color: #f5f5f5;
  padding: 40rpx;
}

/* 登录卡片 */
.login-card {
  width: 600rpx;
  background-color: white;
  border-radius: 32rpx;
  padding: 80rpx 60rpx 60rpx 60rpx;
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.08);
  display: flex;
  flex-direction: column;
  align-items: center;
}

/* Logo容器 */
.logo-container {
  margin-bottom: 60rpx;
}

.logo-image {
  width: 400rpx;
  height: 200rpx;
}

/* 登录按钮 */
.login-button {
  width: 100%;
  height: 88rpx;
  border-radius: 44rpx;
  font-size: 32rpx;
  font-weight: 500;
  border: none;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 20rpx;
}

.login-button.primary {
  background-color: #4CAF50;
  color: white;
  box-shadow: 0 4rpx 16rpx rgba(76, 175, 80, 0.3);
}

.login-button.secondary {
  background-color: #f5f5f5;
  color: #333;
}

.login-button::after {
  border: none;
}

.button-icon {
  font-size: 36rpx;
  margin-right: 12rpx;
}

/* 其他登录方式 */
.other-login {
  width: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 30rpx 0;
  cursor: pointer;
}

.other-login-text {
  font-size: 28rpx;
  color: #999;
  margin-right: 8rpx;
}

.arrow {
  font-size: 20rpx;
  color: #999;
  transition: transform 0.3s;
}

.arrow.up {
  transform: rotate(180deg);
}

/* 登录方式容器 */
.login-methods {
  width: 100%;
  max-height: 0;
  overflow: hidden;
  transition: max-height 0.3s ease-in-out;
}

.login-methods.show {
  max-height: 1000rpx;
}

/* 手机登录区域 */
.phone-login-section {
  width: 100%;
  margin-bottom: 20rpx;
}

.input-group {
  width: 100%;
  margin-bottom: 20rpx;
}

.input-field {
  width: 100%;
  height: 88rpx;
  background-color: #f5f5f5;
  border-radius: 44rpx;
  padding: 0 30rpx;
  font-size: 28rpx;
  box-sizing: border-box;
}

.code-group {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.code-input {
  flex: 1;
}

.send-code-btn {
  width: 180rpx;
  height: 88rpx;
  background-color: #4CAF50;
  color: white;
  border-radius: 44rpx;
  font-size: 28rpx;
  border: none;
  display: flex;
  align-items: center;
  justify-content: center;
}

.send-code-btn.disabled {
  background-color: #ccc;
}

.send-code-btn::after {
  border: none;
}

/* 底部Logo */
.bottom-logo {
  position: absolute;
  bottom: 100rpx;
}

.logo-text {
  font-size: 48rpx;
  font-weight: 300;
  color: #4CAF50;
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
  letter-spacing: 2rpx;
}
