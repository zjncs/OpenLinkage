/* pages/reminder/reminder.wxss */
.reminder-container {
  min-height: 100vh;
  background: #f5f5f5;
  padding-bottom: 100rpx;
}

/* 日历部分 */
.calendar-section {
  background: white;
  padding: 30rpx;
  margin-bottom: 20rpx;
}

.calendar-header {
  margin-bottom: 20rpx;
}

.month-text {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
}

.calendar-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
}

.calendar-day {
  width: calc((100% - 60rpx) / 7);
  height: 80rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 12rpx;
  background: #f8f8f8;
}

.calendar-day.today {
  background: #667eea;
  color: white;
}

.calendar-day.selected {
  background: #667eea;
  color: white;
}

.day-number {
  font-size: 28rpx;
}

/* 提醒列表部分 */
.reminder-section {
  background: white;
  padding: 30rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 30rpx;
}

.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 80rpx 0;
}

.empty-text {
  font-size: 28rpx;
  color: #999;
  margin-bottom: 10rpx;
}

.empty-hint {
  font-size: 24rpx;
  color: #ccc;
}

.reminder-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.reminder-item {
  display: flex;
  align-items: center;
  padding: 30rpx;
  background: #f8f8f8;
  border-radius: 16rpx;
}

.medicine-icon {
  width: 80rpx;
  height: 80rpx;
  background: white;
  border-radius: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 20rpx;
}

.icon-text {
  font-size: 40rpx;
}

.reminder-info {
  flex: 1;
}

.medicine-name {
  margin-bottom: 10rpx;
}

.name-text {
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
  margin-right: 10rpx;
}

.dosage-text {
  font-size: 24rpx;
  color: #999;
}

.reminder-time {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.time-icon,
.frequency-icon {
  font-size: 24rpx;
}

.time-text,
.frequency-text {
  font-size: 24rpx;
  color: #666;
}

.reminder-actions {
  margin-left: 20rpx;
}

.delete-btn {
  padding: 10rpx 20rpx;
  background: #ff6b6b;
  color: white;
  border-radius: 8rpx;
  font-size: 24rpx;
}

/* 添加按钮 */
.add-btn {
  position: fixed;
  right: 40rpx;
  bottom: 100rpx;
  width: 100rpx;
  height: 100rpx;
  background: #4caf50;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4rpx 12rpx rgba(76, 175, 80, 0.4);
}

.add-icon {
  font-size: 60rpx;
  color: white;
  font-weight: 300;
}
