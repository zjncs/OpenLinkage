/* pages/history/history.wxss */
.history-container {
  height: 100vh;
  display: flex;
  flex-direction: column;
  background-color: #f5f5f5;
  padding-bottom: 50px;
  box-sizing: border-box;
}

/* 日历部分 */
.calendar-section {
  background-color: white;
  padding: 20rpx;
  border-bottom: 1rpx solid #e0e0e0;
}

/* 星期标题 */
.weekdays {
  display: flex;
  justify-content: space-around;
  margin-bottom: 20rpx;
}

.weekday {
  width: 14.28%;
  text-align: center;
  font-size: 24rpx;
  color: #999;
  font-weight: 500;
}

/* 日历网格 */
.calendar-grid {
  display: flex;
  flex-wrap: wrap;
}

.calendar-day {
  width: 14.28%;
  height: 100rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  position: relative;
  margin-bottom: 10rpx;
}

.day-number {
  font-size: 28rpx;
  color: #333;
  margin-bottom: 4rpx;
}

.calendar-day.other-month .day-number {
  color: #ccc;
}

/* 今天的样式 */
.calendar-day.today .day-number {
  background-color: #5B6EF5;
  color: white;
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-weight: 500;
}

/* 日期下方的彩色小点 */
.record-dots {
  display: flex;
  gap: 4rpx;
  position: absolute;
  bottom: 8rpx;
}

.dot {
  width: 8rpx;
  height: 8rpx;
  border-radius: 50%;
}

/* 食药提醒部分 */
.reminder-section {
  flex: 1;
  display: flex;
  flex-direction: column;
  background-color: white;
  margin-top: 20rpx;
  overflow: hidden;
}

.section-header {
  padding: 30rpx 30rpx 20rpx 30rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.section-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
}

/* 空状态 */
.empty-reminder {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 80rpx 0;
}

.empty-text {
  font-size: 28rpx;
  color: #999;
}

/* 提醒列表 */
.reminder-list {
  flex: 1;
  padding: 0 30rpx;
  padding-bottom: 20rpx;
}

.reminder-item {
  display: flex;
  align-items: center;
  padding: 30rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
}

.reminder-item:last-child {
  border-bottom: none;
}

/* 药物图标 */
.medicine-icon {
  width: 80rpx;
  height: 80rpx;
  background: #f0f0f0;
  border-radius: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 20rpx;
}

.icon-text {
  font-size: 40rpx;
}

/* 提醒信息 */
.reminder-info {
  flex: 1;
}

.medicine-name-row {
  display: flex;
  align-items: baseline;
  gap: 12rpx;
  margin-bottom: 10rpx;
}

.medicine-name {
  font-size: 30rpx;
  font-weight: 500;
  color: #333;
}

.medicine-dosage {
  font-size: 24rpx;
  color: #999;
}

.reminder-details {
  display: flex;
  gap: 24rpx;
}

.detail-item {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.detail-item .icon {
  font-size: 24rpx;
}

.detail-text {
  font-size: 24rpx;
  color: #666;
}

/* 添加按钮 */
.add-button {
  position: fixed;
  right: 40rpx;
  bottom: 100rpx;
  width: 112rpx;
  height: 112rpx;
  border-radius: 50%;
  background-color: #4CAF50;
  box-shadow: 0 8rpx 24rpx rgba(76, 175, 80, 0.4);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 100;
}

.add-icon {
  font-size: 64rpx;
  color: white;
  font-weight: 300;
}
