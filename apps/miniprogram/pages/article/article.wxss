/* pages/article/article.wxss */
.article-container {
  height: 100vh;
  display: flex;
  flex-direction: column;
  background-color: #f5f5f5;
  padding-bottom: 50px;
  box-sizing: border-box;
}

/* 搜索栏 */
.search-bar {
  background-color: #4CAF50;
  padding: 20rpx 30rpx;
  padding-top: calc(20rpx + env(safe-area-inset-top));
}

.search-input {
  display: flex;
  align-items: center;
  background-color: white;
  border-radius: 40rpx;
  padding: 16rpx 24rpx;
  gap: 12rpx;
}

.search-icon {
  width: 32rpx;
  height: 32rpx;
  opacity: 0.5;
}

.search-field {
  flex: 1;
  font-size: 28rpx;
  color: #333;
}

/* 内容区域 */
.content {
  flex: 1;
  padding: 20rpx;
  overflow-y: auto;
}

/* 热门推荐卡片 */
.featured-card {
  width: 100%;
  height: 400rpx;
  border-radius: 20rpx;
  overflow: hidden;
  position: relative;
  margin-bottom: 30rpx;
}

.featured-image {
  width: 100%;
  height: 100%;
}

.featured-overlay {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 30rpx;
  background: linear-gradient(to top, rgba(0, 0, 0, 0.7), transparent);
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.featured-tag {
  display: inline-block;
  align-self: flex-start;
  padding: 8rpx 20rpx;
  background-color: rgba(255, 255, 255, 0.9);
  border-radius: 20rpx;
  font-size: 24rpx;
  color: #FF5722;
  font-weight: 500;
}

.featured-title {
  font-size: 36rpx;
  font-weight: bold;
  color: white;
  line-height: 1.4;
}

/* 文章列表 */
.article-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.article-item {
  display: flex;
  background-color: white;
  border-radius: 16rpx;
  padding: 24rpx;
  gap: 20rpx;
  align-items: center;
}

.article-content {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  min-width: 0;
}

.article-tag {
  display: inline-block;
  align-self: flex-start;
  padding: 4rpx 16rpx;
  background-color: #FFE8E8;
  border-radius: 8rpx;
  font-size: 22rpx;
  color: #FF5722;
  font-weight: 500;
}

.article-title {
  font-size: 30rpx;
  font-weight: 500;
  color: #333;
  line-height: 1.5;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

.article-date {
  font-size: 24rpx;
  color: #999;
}

.article-thumb {
  width: 200rpx;
  height: 150rpx;
  border-radius: 12rpx;
  flex-shrink: 0;
}
